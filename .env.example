# StreamForge configuration template.
# Copy to .env (gitignored) and fill in real values. Never commit .env or key files.
# Run commands from the repo root: .env is loaded from the current directory,
# and real environment variables override values in .env.

# --- Redpanda / Kafka (defaults suit the local Docker Compose stack) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_EVENTS_TOPIC=ecommerce.events
KAFKA_DLQ_TOPIC=ecommerce.events.dlq
KAFKA_CONSUMER_GROUP=streamforge-consumer

# --- Snowflake (required for consumer, dbt and dashboard) ---
# Account identifier, NOT the URL. Example format: myorg-myaccount
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=<user>
# Resources created by the M4 setup (they may be set before they exist).
SNOWFLAKE_WAREHOUSE=STREAMFORGE_WH
SNOWFLAKE_DATABASE=ECOMMERCE_STREAMING_DB
# Application role (least privilege). Never ACCOUNTADMIN. The setup command
# (python -m streamforge.admin.snowflake_setup apply) switches roles itself; it only
# needs the user to hold ACCOUNTADMIN. See docs/snowflake.md.
SNOWFLAKE_ROLE=STREAMFORGE_ROLE

# Auth: set exactly ONE of the three options below. Leave the others empty.
# Option A: programmatic access token (PAT), generated in Snowsight under your
#           user profile. Uses the connector's PROGRAMMATIC_ACCESS_TOKEN authenticator.
#           Snowflake requires a network policy on the user before a PAT can be used.
SNOWFLAKE_TOKEN=
# Option B (used by StreamForge): key-pair auth with an encrypted PKCS#8 key.
#           Keep the key file outside the repo, e.g. ~/.snowflake/keys/<name>.p8
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Option C: password (likely rejected if your user requires MFA).
SNOWFLAKE_PASSWORD=
